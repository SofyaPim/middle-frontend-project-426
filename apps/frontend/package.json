{
  "name": "@pc-shop/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "gen:types": "openapi-typescript ../../spec/openapi.yaml -o src/generated/schema.d.ts"
  },
  "dependencies": {
    "@sentry/react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "openapi-typescript": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
